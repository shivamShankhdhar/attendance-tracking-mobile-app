{
  "expo": {
    "name": "Bizora",
    "slug": "bizora",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "bizora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "bizora.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow Bizora to access your camera to scan workplace QR codes for attendance.",
        "NSMicrophoneUsageDescription": "Allow Bizora to access your microphone."
      }
    },
    "android": {
      "package": "bizora.app",
      "versionCode": 12,
      "permissions": [
      ],
      "adaptiveIcon": {
        "backgroundColor": "#F8F9F3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#F8F9F3",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Bizora to access your camera to scan workplace QR codes for attendance.",
          "microphonePermission": "Allow Bizora to access your microphone."
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-1113302487630583~1600554870",
          "iosAppId": "ca-app-pub-1113302487630583~1600554870"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  },
  "react-native-google-mobile-ads": {
    "android_app_id": "ca-app-pub-1113302487630583~1600554870",
    "android_sdk": "classic"
  }
}
